{
  "name": "free-research-llm",
  "version": "1.0.0",
  "description": "Free research LLM: one prompt in, a decomposed, source-checked analytical answer out. Runs on free model quotas, on macOS, Windows, Linux or a free cloud VM.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "bin": {
    "frl": "src/frl.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "FRL_DEMO=1 node src/server.mjs",
    "ask": "node src/cli.mjs",
    "test": "vitest run",
    "check": "node --check src/server.mjs && vitest run",
    "quality": "node scripts/quality.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/postinstall.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
