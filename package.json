{
  "name": "free-research-llm",
  "version": "1.0.0",
  "description": "Free research LLM: one prompt in, a decomposed, source-checked analytical answer out. Runs locally on free model quotas.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "frl": "src/frl.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "FRL_DEMO=1 node src/server.mjs",
    "ask": "node src/cli.mjs",
    "test": "vitest run",
    "check": "node --check src/server.mjs && vitest run",
    "autoloop": "node src/loop/cli.mjs",
    "quality": "node scripts/quality.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "postinstall": "git config core.hooksPath .githooks || true",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vitest": "^3.2.7"
  }
}
